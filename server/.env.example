# PAISA API — environment template. Copy to server/.env and fill in.
# An EMPTY value means "not configured": that feature switches itself off
# (emails go to the server log, online payments are hidden, files stay on disk).
# Never put real secrets in this file — it is committed.

# ── Core (required) ───────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/paisa
# Long random strings; use NEW values in production.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Web app address, used in email links (password reset, welcome).
FRONTEND_URL=http://localhost:5173

# ── Razorpay: online payments + subscriptions ─────────────────────
# Dashboard → Test Mode → Account & Settings → API Keys.
# RAZORPAY_KEY is accepted instead of RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → https://<api-domain>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Resend: email ─────────────────────────────────────────────────
# resend.com → API Keys. Verify your domain, or use onboarding@resend.dev to test.
RESEND_API_KEY=
EMAIL_FROM=PAISA <no-reply@example.com>

# ── File storage ──────────────────────────────────────────────────
# "local" (files under STORAGE_PATH on the server) or "s3".
# Switching is safe: each file remembers where it was stored.
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
# S3 / S3-compatible (STORAGE_PROVIDER=s3). Keep the bucket PRIVATE —
# downloads go through the app's access checks.
# AWS: IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for non-AWS services, e.g. https://<account>.r2.cloudflarestorage.com
# (Cloudflare R2), http://localhost:9000 (MinIO). Empty for AWS.
S3_ENDPOINT=

# ── Optional ──────────────────────────────────────────────────────
# Two-factor secrets encryption key (defaults to one derived from JWT_REFRESH_SECRET).
TWO_FACTOR_ENCRYPTION_KEY=
# Video calls (free public server by default).
JITSI_DOMAIN=meet.jit.si
# Scheduled jobs (overdue invoices, reminders, clean-up); "false" turns them off.
JOBS_ENABLED=true
# Redis is optional unless REDIS_REQUIRED=true (needed for several API servers).
REDIS_REQUIRED=false
# SMS (not implemented yet)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
